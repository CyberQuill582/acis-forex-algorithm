+                          {"planted": [], "null": ["section-14 win_rate"]}, calls)
+    assert mod.main() == 0                                                 # planted passed, null did not
+    assert {c for c in calls if c[0] == "grade"} == {("grade", "planted"), ("grade", "null")}
+    run = next((tmp_path / "data" / "validation" / "falsification").iterdir())
+    assert not (run / "oracle_deflation.json").exists()
+    out = capsys.readouterr().out
+    assert "oracle deflated" not in out and "DSR=" not in out
+    hurdles = [line for line in out.splitlines() if "SR0 hurdle" in line]
+    assert len(hurdles) == 2 and all("= 0.345 (a hurdle" in line for line in hurdles)
+
+
+def test_the_harness_recognises_the_oracle_on_planted_and_refuses_it_on_null(cfg) -> None:
+    """The positive control itself: two folds of the falsification plan's shape on one
+    instrument, every declared C8 cost charged. On planted the oracle must make money after
+    costs with a strongly positive Sharpe, significant by the harness's own PSR; on null the
+    SAME trades (same schedule, same timing) must show no edge."""
+    folds = plan(1, 7, 2)
+    days = (folds[-1].test_end - START).days
+    graded = {}
+    for kind in ("planted", "null"):
+        spec = MarketSpec(kind, START, days, (("EUR_USD", FIRST_MID["EUR_USD"]),))
+        graded[kind] = grade_oracle(spec, cfg, cfg.system.active_account, folds, CapturingLogger(),
+                                    instruments=["EUR_USD"])
+    planted, null = graded["planted"], graded["null"]
+    p, n = planted.report.out_of_sample, null.report.out_of_sample
+    assert p.n_trades == n.n_trades >= 30                                  # identical oracle logic
+    assert set(planted.report.per_strategy) == {STRATEGY}
+    assert planted.net_pnl > 0 and p.annual_sharpe > 5.0, (planted.net_pnl, p)
+    assert planted.report.deflated_sharpe >= 0.95                         # PSR vs 0: no trials
+    assert planted.report.trial_count == 0 and planted.report.passed is False   # the gate's own refusal
+    assert null.report.deflated_sharpe < 0.95, null.report.deflated_sharpe   # no significant edge
+    assert null.net_pnl < planted.net_pnl / 10
+    assert any(f.startswith("section-14") for f in non_dsr_failures(null.report, guardrail_hash(cfg.guardrails)))
diff --git a/tests/backtest/test_oracle_full_scale.py b/tests/backtest/test_oracle_full_scale.py
new file mode 100644
index 0000000..c6bbd54
--- /dev/null
+++ b/tests/backtest/test_oracle_full_scale.py
@@ -0,0 +1,81 @@
+"""The oracle positive control at FULL fold scale on a coarse tape (audits F1, F2, E1).
+
+The falsification plan's fold count (25 folds, > 2 graded years) on a 300 s tape grades in seconds,
+so the suite can pin what stage 1 of `scripts/falsify_engine.py` would decide, instead of learning
+it after ~20 minutes of compute and a VOID. One instrument (EUR_USD); the account varies per test.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from config.account_doctrine import guardrail_hash
+from config.schemas import load_config
+from tests.backtest.oracle import grade_oracle, non_dsr_failures, void_reasons
+from tests.backtest.report import PROFIT_FACTOR_MIN
+from tests.backtest.synthetic_grade import START, plan
+from tests.backtest.synthetic_market import MarketSpec
+from tests.optimizer_fixtures import CapturingLogger
+
+ROOT = Path(__file__).resolve().parents[2]
+FOLDS = plan(1, 30, 25)                                   # the falsification fold count, short trains
+DAYS = (FOLDS[-1].test_end - START).days
+
+
+@pytest.fixture(scope="module")
+def cfg():
+    return load_config(ROOT / "config")
+
+
+def _grade(cfg, kind: str, account: str, sign_error: float = 0.0):
+    spec = MarketSpec(kind, START, DAYS, (("EUR_USD", 1.10),), tick_seconds=300)
+    return grade_oracle(spec, cfg, account, FOLDS, CapturingLogger(), instruments=["EUR_USD"],
+                        sign_error=sign_error)
+
+
+def test_the_planted_oracle_clears_every_non_dsr_clause_at_full_fold_scale(cfg) -> None:
+    """Audit F1: the 2-fold positive control asserted net > 0 and a Sharpe, so a §14 change only
+    the full-scale oracle cannot meet (e.g. DURATION_MAX_S = 4 h against its ~7 h holds) left the
+    whole suite green and would VOID every real stage-1 run. Here the full fold count grades."""
+    hash_ = guardrail_hash(cfg.guardrails)
+    fails = {k: non_dsr_failures(_grade(cfg, k, "dev_paper").report, hash_) for k in ("planted", "null")}
+    assert fails["planted"] == (), fails["planted"]
+    assert void_reasons(fails) == []
+
+
+# the rungs for THIS tape (coarse, one instrument); the falsification tape has its own (oracle.RUNGS)
+COARSE_RUNGS = {"planted-near-pass": 0.42, "planted-near-fail": 0.45}
+
+
+def test_the_harness_passes_a_rung_just_above_the_cut_offs_and_refuses_one_just_below(cfg) -> None:
+    """Audit E1: the perfect oracle clears §14 by a mile (PF ~13 here), so it says nothing about
+    the harness's power near the decision level. Two weaker rungs of the SAME oracle — wrong on
+    42% / 45% of whole episodes — bracket the binding cut-off (profit factor 1.4 for this trade
+    structure; the Sharpe cut is never binding first): the harness must pass the one above and
+    refuse the one below, by that §14 row, not by a rule or a floor."""
+    hash_ = guardrail_hash(cfg.guardrails)
+    grades = {k: _grade(cfg, "planted", "dev_paper", p) for k, p in COARSE_RUNGS.items()}
+    fails = {k: non_dsr_failures(g.report, hash_) for k, g in grades.items()}
+    assert fails["planted-near-pass"] == ()
+    assert fails["planted-near-fail"] == ("section-14 profit_factor",)
+    pf = {k: g.report.out_of_sample.profit_factor for k, g in grades.items()}
+    cut = PROFIT_FACTOR_MIN                                               # the ratified §14 value, one source
+    assert cut < pf["planted-near-pass"] < cut + 0.2 and cut - 0.2 < pf["planted-near-fail"] < cut, pf
+    assert void_reasons(fails) == []
+
+
+def test_on_a_weekend_flat_min_hold_account_the_oracle_keeps_the_rules_and_the_grade_decides(cfg) -> None:
+    """Audit F2: on prop_demo (weekend holding forbidden, 60 s minimum hold) every stage-1 run used
+    to VOID on `weekend_holding`, and null was "refused" by that rule whatever its metrics. Now no
+    oracle breaks a rule, planted clears every non-DSR clause, and null is refused by §14 rows."""
+    rulebook = cfg.platform_rules.accounts["prop_demo"]
+    assert not rulebook.weekend_holding_allowed and rulebook.min_hold_seconds > 0   # fixture precondition
+    hash_ = guardrail_hash(cfg.guardrails)
+    planted, null = _grade(cfg, "planted", "prop_demo"), _grade(cfg, "null", "prop_demo")
+    assert planted.report.rule_violations == () and null.report.rule_violations == ()
+    fails = {"planted": non_dsr_failures(planted.report, hash_), "null": non_dsr_failures(null.report, hash_)}
+    assert fails["planted"] == ()
+    assert fails["null"] and all(f.startswith("section-14") for f in fails["null"])
+    assert void_reasons(fails) == []
diff --git a/tests/backtest/test_oracle_loop.py b/tests/backtest/test_oracle_loop.py
new file mode 100644
index 0000000..0d7c2be
--- /dev/null
+++ b/tests/backtest/test_oracle_loop.py
@@ -0,0 +1,91 @@
+"""The oracle keeps the account's evaluable rules (audit F2), and the book honours a close order.
+
+On a weekend-flat account (FTMO, prop_demo) the harness books any hold across Friday's rollover as
+`weekend_holding`, and every stage-1 run VOIDed whatever the grade did, while null and permuted were
+"refused" by that same rule, vacuously. The oracle now flattens before the weekend and never
+reverses or closes a position younger than `min_hold_seconds`.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+
+from config.schemas import AccountRulebook, NewsRules
+from core.data.fx_clock import rollover_utc
+from tests.backtest.book import BookState, PositionModel
+from tests.backtest.oracle_loop import FLATTEN_LEAD, OracleLoop, OracleTick
+from tests.backtest.synthetic_market import MarketSpec, SyntheticMarket, episodes
+from tests.backtest.test_harness_regressions import _ms, _order
+from tests.optimizer_fixtures import TEST_COSTS
+
+UTC = timezone.utc
+START = datetime(2014, 1, 6, tzinfo=UTC)                     # a Monday
+FRIDAY = datetime(2014, 1, 10, tzinfo=UTC)
+PRICES = (("EUR_USD", 1.10),)
+
+
+def _rulebook(**over) -> AccountRulebook:
+    base = dict(platform="dev", news=NewsRules(restricted=False), min_hold_seconds=60, max_lots=None,
+                weekend_holding_allowed=False, drawdown_rules=[])
+    return AccountRulebook(**{**base, **over})
+
+
+def _tick(ts: datetime, mid: float = 1.10) -> OracleTick:
+    return OracleTick(ts, "EUR_USD", mid - 2e-5, mid + 2e-5, 4e-5, mid)
+
+
+def _actions(loop: OracleLoop) -> list[tuple[str, datetime]]:
+    return [(o.action, o.sized_at) for o in loop.book.orders]
+
+
+def test_a_weekend_flat_oracle_is_flat_before_fridays_rollover_and_reopens_after_it() -> None:
+    loop = OracleLoop(SyntheticMarket(MarketSpec("planted", START, 14, PRICES)), Decimal("10000"), _rulebook())
+    cutoff = rollover_utc(FRIDAY.date())                              # 22:00 UTC in January (EST)
+    flat_at = cutoff - FLATTEN_LEAD
+    for ts in (cutoff - timedelta(hours=1), flat_at - timedelta(seconds=20), flat_at,
+               flat_at + timedelta(minutes=10), START + timedelta(days=7)):
+        loop.on_state(_tick(ts))
+    assert [a for a, _ in _actions(loop)] == ["open", "close", "open"]
+    assert _actions(loop)[1][1] == flat_at and _actions(loop)[2][1] == START + timedelta(days=7)
+    allowed = OracleLoop(SyntheticMarket(MarketSpec("planted", START, 14, PRICES)), Decimal("10000"),
+                         _rulebook(weekend_holding_allowed=True))
+    for ts in (cutoff - timedelta(hours=1), flat_at):
+        allowed.on_state(_tick(ts))
+    assert [a for a, _ in _actions(allowed)] == ["open"]              # weekend allowed: it holds
+
+
+def test_nothing_opens_in_the_wind_down_before_the_flatten() -> None:
+    """A position opened in the last `min_hold` before the flatten would be closed too young."""
+    loop = OracleLoop(SyntheticMarket(MarketSpec("planted", START, 14, PRICES)), Decimal("10000"), _rulebook())
+    flat_at = rollover_utc(FRIDAY.date()) - FLATTEN_LEAD
+    loop.on_state(_tick(flat_at - timedelta(seconds=40)))             # inside the 60 s wind-down
+    loop.on_state(_tick(flat_at))
+    assert loop.book.orders == []
+
+
+def test_a_flip_waits_until_the_position_is_min_hold_old() -> None:
+    market = SyntheticMarket(MarketSpec("planted", START, 7, PRICES))
+    ticks = list(market.load("EUR_USD", START, START + timedelta(hours=20)))
+    flip = next(ep.start for a, ep in zip(episodes(market.spec, 0), episodes(market.spec, 0)[1:])
+                if ep.sign != a.sign)                                  # first sign change (20 s ticks)
+    loop = OracleLoop(market, Decimal("10000"), _rulebook(weekend_holding_allowed=True))
+    for t in ticks[flip - 1:flip + 3]:                                # opened 20 s before the flip
+        loop.on_state(_tick(t.event_time))
+    opened, reversed_ = loop.book.orders
+    assert reversed_.direction == -opened.direction
+    assert reversed_.sized_at - opened.sized_at == timedelta(seconds=60)   # not at 20 s or 40 s
+
+
+def test_the_book_closes_on_a_close_order_at_the_ticks_mid_and_ignores_one_with_nothing_open() -> None:
+    model, book = PositionModel(costs={"EUR_USD": TEST_COSTS}, max_hold_s=86400), BookState()
+    t0 = datetime(2026, 1, 6, 10, tzinfo=UTC)
+    model.apply_order(_order(t0, 1, 1.10, 1.05, None), _ms(t0, 1.10), book)
+    close = dataclasses.replace(_order(t0 + timedelta(hours=1), 1, 1.10, 1.05, None), action="close")
+    model.apply_order(close, _ms(t0 + timedelta(hours=1), 1.12), book)
+    (trade,) = book.trades
+    assert book.open_by_inst == {} and trade.exit_ts == t0 + timedelta(hours=1)
+    assert trade.pnl > Decimal("19")                                  # filled at 1.12, not the order's 1.10
+    model.apply_order(close, _ms(t0 + timedelta(hours=2), 1.13), book)
+    assert len(book.trades) == 1 and book.open_by_inst == {}          # nothing open: a no-op
diff --git a/tests/backtest/test_strict_json.py b/tests/backtest/test_strict_json.py
new file mode 100644
index 0000000..cf3259b
--- /dev/null
+++ b/tests/backtest/test_strict_json.py
@@ -0,0 +1,59 @@
+"""No bare NaN in any JSON the backtest writes (audits F6/E7).
+
+RFC 8259 §6: "Numeric values that cannot be represented in the grammar below (such as Infinity and
+NaN) are not permitted." Python's `json.dumps` writes them by default. After the empty-mean fix
+(GAP-P12D-38) a rung whose §14 duration band is empty carries avg_duration_s NaN, and ladder.json
+wrote it as a bare `NaN`. Every writer now goes through `oos_runner.strict_json`, and these tests
+parse the output with a parser that REFUSES the non-standard constants.
+"""
+
+from __future__ import annotations
+
+import json
+import math
+import sys
+from decimal import Decimal
+from pathlib import Path
+
+import pytest
+
+from tests.backtest.oos_runner import report_json, strict_json
+from tests.backtest.test_metrics_and_grader import _block, _report
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "scripts"))
+from cost_stress_ladder import ladder_document  # noqa: E402
+
+
+def _strict(text: str):
+    def refuse(token: str):
+        raise ValueError(f"non-RFC-8259 constant {token}")
+    return json.loads(text, parse_constant=refuse)
+
+
+def test_strict_json_writes_every_non_finite_float_as_null() -> None:
+    value = {"a": math.nan, "b": [math.inf, -math.inf, 1.5], "c": {"d": math.nan}, "e": Decimal("1.25")}
+    assert _strict(strict_json(value)) == {"a": None, "b": [None, None, 1.5], "c": {"d": None}, "e": "1.25"}
+    with pytest.raises(ValueError, match="non-RFC-8259"):
+        _strict(json.dumps({"a": math.nan}))                       # what the default writer produced
+
+
+def _row(stress: float, net: str) -> dict:
+    return {"kind": "planted", "tag": f"rung_{stress:g}x", "cost_stress": stress, "spread_floor": 0.0,
+            "passed": False, "trades": 40, "sharpe": math.nan, "profit_factor": math.inf, "win_rate": 1.0,
+            "avg_duration_s": math.nan, "max_drawdown_pct": 0.0, "net_pnl": net, "dsr": math.nan,
+            "trials": 0, "failed": ["avg_duration"], "seconds": 1.0}
+
+
+def test_the_ladder_document_is_strict_json_even_when_the_duration_band_is_empty() -> None:
+    text = ladder_document(kind="planted", account="dev_paper", folds=25, days=985, bar=2.0, quick=False,
+                           rows=[_row(1.0, "-5.0"), _row(2.0, "-7.0")])
+    doc = _strict(text)
+    assert doc["rungs"][0]["avg_duration_s"] is None and doc["rungs"][0]["dsr"] is None
+    assert doc["rungs"][0]["profit_factor"] is None and doc["verdict"].startswith("NO EDGE TO STRESS")
+
+
+def test_a_validation_report_with_non_finite_metrics_is_strict_json() -> None:
+    report = _report(out_of_sample=_block(avg_trade_duration_s=math.nan, profit_factor=math.inf),
+                     deflated_sharpe=math.nan)
+    doc = _strict(report_json(report))
+    assert doc["out_of_sample"]["avg_trade_duration_s"] is None and doc["deflated_sharpe"] is None
diff --git a/tests/backtest/test_zero_duration_artifacts.py b/tests/backtest/test_zero_duration_artifacts.py
new file mode 100644
index 0000000..2f99168
--- /dev/null
+++ b/tests/backtest/test_zero_duration_artifacts.py
@@ -0,0 +1,99 @@
+"""GAP-P12D-38 — the "79% zero-duration trades" were never trades: the minimal reproduction.
+
+Two facts, each pinned here, produced the finding:
+  1. On a synthetic tape every tick is 20 s after the last, so the factory's 10 s tick-velocity
+     window always holds exactly one tick: velocity == its own session median, the surge ratio
+     is exactly 1.0, and MOMENTUM_SCALP (ratio >= momentum_scalp_surge_ratio, schema-floored
+     above 1) can NEVER fire on any synthetic market. Its population is empty in every run.
+     (A second, independent barrier: at ratio 1.0 its conviction clamp01(ratio / 3) = 0.333 is
+     under conviction_discard, whose stageable floor is 0.45. Loosening the gate alone is an
+     equivalent mutant; only removing both lets it fire, which this test catches.)
+  2. `metrics._avg_duration` reported an EMPTY population's mean as 0.0 — the same number a
+     population of genuinely zero-duration trades would give. A finder read the empty scalp
+     carve-out as ~1,598 zero-duration trades. The mean of nothing is now NaN (null in JSON).
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import math
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+from pathlib import Path
+
+import pytest
+
+from config.schemas import load_config
+from core.regime.regime_types import LiqState, RegimeType
+from core.signals.agon import AGON
+from core.signals.canonical import register_canonical
+from core.signals.provenance import ProvenanceStore
+from core.signals.signal_types import StrategyType
+from tests.backtest.data_loader import BacktestDataLoader
+from tests.backtest.metrics import ClosedTrade, compute_metrics
+from tests.backtest.synthetic_market import MarketSpec, SyntheticMarket
+from tests.backtest.tick_stream import build_factory, market_states
+from tests.optimizer_fixtures import CapturingLogger
+from tests.signals_fixtures import make_paramset, mk_regime
+
+ROOT = Path(__file__).resolve().parents[2]
+UTC = timezone.utc
+START = datetime(2014, 1, 6, tzinfo=UTC)
+
+
+def test_momentum_scalp_can_never_fire_on_a_uniform_synthetic_tape(tmp_path) -> None:
+    cfg = load_config(ROOT / "config")
+    m = SyntheticMarket(MarketSpec("planted", START, 7, (("EUR_USD", 1.10),)))
+    factory = build_factory(cfg, ["EUR_USD"])
+    store = ProvenanceStore(tmp_path / "provenance.db", cfg.system.provenance.revalidation_cadence_days,
+                            CapturingLogger())
+    register_canonical(store, START)
+
+    def agon() -> AGON:          # wired exactly as build_paper_loop wires it
+        return AGON(cfg.system.signals, cfg.instruments.pair_relationships, store,
+                    lambda inst, sess, kind: factory.session_median(inst, sess, kind) or 0.0,
+                    CapturingLogger())
+
+    real, surged = agon(), agon()
+    regime = mk_regime(RegimeType.STRONG_TREND_UP, liq=LiqState.DEEP)   # the scalp's gate is open
+    params = make_paramset()
+    fired = {"real": 0, "surged": 0}
+    ratios = set()
+    states = market_states(cfg=cfg, loader=BacktestDataLoader({m.name: m}, CapturingLogger()),
+                           factory=factory, source=m.name, instruments=["EUR_USD"],
+                           start=START, end=START + timedelta(hours=4))
+    for st in states:
+        median = factory.session_median("EUR_USD", st.session, "velocity")
+        if median is not None:
+            ratios.add(st.tick_velocity / median)
+        fast = dataclasses.replace(st, tick_velocity=st.tick_velocity * 2)  # the SAME bars, surging
+        for name, a, s in (("real", real, st), ("surged", surged, fast)):
+            a.observe(s)
+            sigs = a.generate(s, regime, params, s.timestamp)
+            fired[name] += sum(sig.strategy_type is StrategyType.MOMENTUM_SCALP for sig in sigs)
+    assert ratios == {1.0}                                     # pinned, every tick
+    assert cfg.system.signals.momentum_scalp_surge_ratio > 1.0
+    assert fired["real"] == 0
+    assert fired["surged"] > 0                                 # the module is alive, the tape is not
+
+
+def _trade(minutes: float, strategy: str) -> ClosedTrade:
+    t0 = datetime(2026, 1, 6, 10, tzinfo=UTC)
+    return ClosedTrade(entry_ts=t0, exit_ts=t0 + timedelta(minutes=minutes), pnl=Decimal("1"),
+                       strategy_type=strategy)
+
+
+def _metrics(trades):
+    eq = [(datetime(2026, 1, 5, tzinfo=UTC), Decimal("10000"))]
+    return compute_metrics(trades=trades, equity_curve=eq, rollover_marks=[], spx_closes={},
+                           periods_per_year=252)
+
+
+def test_an_empty_carve_out_has_no_mean_duration_never_zero() -> None:
+    m = _metrics([_trade(60, "TREND")])
+    assert math.isnan(m.scalp_avg_duration_s) and math.isnan(m.tsmom_avg_duration_s)
+    assert m.as_dict()["scalp_avg_duration_s"] is None          # null in every report json
+    zero = _metrics([_trade(60, "TREND"), _trade(0, "MOMENTUM_SCALP")])
+    assert zero.scalp_avg_duration_s == 0.0                      # a REAL zero is still visible
+    empty_band = _metrics([_trade(30, "TSMOM")])
+    assert math.isnan(empty_band.avg_trade_duration_s)
