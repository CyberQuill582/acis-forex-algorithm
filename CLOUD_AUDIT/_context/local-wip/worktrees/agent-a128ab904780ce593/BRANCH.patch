+ROOT = Path(__file__).resolve().parents[2]
+PAIR = (("EUR_USD", 1.10), ("USD_JPY", 110.0))
+
+
+@pytest.fixture(scope="module")
+def cfg():
+    return load_config(ROOT / "config")
