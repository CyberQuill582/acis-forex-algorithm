+             _report(rule_violations=["min_hold"]), _report(guardrail_hash="TAMPERED")]
+    for r in cases:
+        assert r.passed is (not non_dsr_failures(r, GH)), (r.passed, non_dsr_failures(r, GH))
+    assert non_dsr_failures(_report(trial_count=0, deflated_sharpe=float("nan")), GH) == ()
+
+
+def test_void_reasons_need_planted_recognised_and_every_control_refused() -> None:
+    assert void_reasons({"planted": (), "null": ("section-14 win_rate",),
+                         "permuted": ("section-14 annual_sharpe",)}) == []
+    assert "planted oracle failed" in void_reasons({"planted": ("section-14 avg_duration",)})[0]
+    assert "null oracle cleared" in void_reasons({"planted": (), "null": ()})[0]
+
+
+def _falsify_script(monkeypatch, tmp_path, cfg, oracle_failures: dict, calls: list):
+    """scripts/falsify_engine.py with the heavy stages stubbed: threads, not processes, and its
+    ROOT moved to `tmp_path` so no run directory is written under any data/."""
+    spec = importlib.util.spec_from_file_location("falsify_engine", ROOT / "scripts" / "falsify_engine.py")
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+
+    def oracle_row(s, out, account, folds, root):
+        return {"kind": s.kind, "trades": 40, "net_pnl": "1", "sharpe": 9.0, "psr": 1.0,
+                "non_dsr_failures": oracle_failures[s.kind], "trade_returns": [0.01, 0.02, 0.015], "seconds": 0}
+
+    def label_year(s, instrument, year, out, root):
+        calls.append(("label", s.kind))
+        return s.kind, instrument, year, 1, 0.0
+
+    def grade(s, out, account, folds, root):
+        calls.append(("grade", s.kind))
+        return {"kind": s.kind, "passed": s.kind == "planted", "trades": 40, "sharpe": 0.0, "dsr": 0.0,
+                "trials": 4, "trial_sharpes": [0.1, 0.2, 0.3, 0.4], "champions": [], "failed": [], "seconds": 0}
+
+    monkeypatch.setattr(mod, "ROOT", tmp_path)
+    monkeypatch.setattr(mod, "load_config", lambda path: cfg)
+    for name, fn in (("oracle_row", oracle_row), ("label_year", label_year), ("grade", grade),
+                     ("ProcessPoolExecutor", ThreadPoolExecutor)):
+        monkeypatch.setattr(mod, name, fn)
+    monkeypatch.setattr(sys, "argv", ["falsify_engine.py", "--kinds", *oracle_failures])
+    return mod
+
+
+def test_a_failed_oracle_voids_the_verdict_before_any_engine_compute(monkeypatch, tmp_path, cfg, capsys) -> None:
+    calls: list = []
+    mod = _falsify_script(monkeypatch, tmp_path, cfg,
+                          {"planted": ["section-14 avg_duration"], "null": ["section-14 win_rate"]}, calls)
+    assert mod.main() == 4
+    assert calls == []                                                     # the engine never ran
+    assert "VERDICT VOID" in capsys.readouterr().out
+
+
+def test_a_recognised_oracle_hands_over_to_the_unchanged_engine_stage(monkeypatch, tmp_path, cfg) -> None:
+    calls: list = []
+    mod = _falsify_script(monkeypatch, tmp_path, cfg,
+                          {"planted": [], "null": ["section-14 win_rate"]}, calls)
+    assert mod.main() == 0                                                 # planted passed, null did not
+    assert {c for c in calls if c[0] == "grade"} == {("grade", "planted"), ("grade", "null")}
+    run = next((tmp_path / "data" / "validation" / "falsification").iterdir())
+    deflation = json.loads((run / "oracle_deflation.json").read_text(encoding="utf-8"))
+    assert set(deflation) == {"planted", "null"} and all(0.0 <= v <= 1.0 for v in deflation.values())
+
+
+def test_the_harness_recognises_the_oracle_on_planted_and_refuses_it_on_null(cfg) -> None:
+    """The positive control itself: two folds of the falsification plan's shape on one
+    instrument, every declared C8 cost charged. On planted the oracle must make money after
+    costs with a strongly positive Sharpe, significant by the harness's own PSR; on null the
+    SAME trades (same schedule, same timing) must show no edge."""
+    folds = plan(1, 7, 2)
+    days = (folds[-1].test_end - START).days
+    graded = {}
+    for kind in ("planted", "null"):
+        spec = MarketSpec(kind, START, days, (("EUR_USD", FIRST_MID["EUR_USD"]),))
+        graded[kind] = grade_oracle(spec, cfg, cfg.system.active_account, folds, CapturingLogger(),
+                                    instruments=["EUR_USD"])
+    planted, null = graded["planted"], graded["null"]
+    p, n = planted.report.out_of_sample, null.report.out_of_sample
+    assert p.n_trades == n.n_trades >= 30                                  # identical oracle logic
+    assert set(planted.report.per_strategy) == {STRATEGY}
+    assert planted.net_pnl > 0 and p.annual_sharpe > 5.0, (planted.net_pnl, p)
+    assert planted.report.deflated_sharpe >= 0.95                         # PSR vs 0: no trials
+    assert planted.report.trial_count == 0 and planted.report.passed is False   # the gate's own refusal
+    assert null.report.deflated_sharpe < 0.95, null.report.deflated_sharpe   # no significant edge
+    assert null.net_pnl < planted.net_pnl / 10
+    assert any(f.startswith("section-14") for f in non_dsr_failures(null.report, guardrail_hash(cfg.guardrails)))
diff --git a/tests/backtest/test_zero_duration_artifacts.py b/tests/backtest/test_zero_duration_artifacts.py
new file mode 100644
index 0000000..2f99168
--- /dev/null
+++ b/tests/backtest/test_zero_duration_artifacts.py
@@ -0,0 +1,99 @@
+"""GAP-P12D-38 — the "79% zero-duration trades" were never trades: the minimal reproduction.
+
+Two facts, each pinned here, produced the finding:
+  1. On a synthetic tape every tick is 20 s after the last, so the factory's 10 s tick-velocity
+     window always holds exactly one tick: velocity == its own session median, the surge ratio
+     is exactly 1.0, and MOMENTUM_SCALP (ratio >= momentum_scalp_surge_ratio, schema-floored
+     above 1) can NEVER fire on any synthetic market. Its population is empty in every run.
+     (A second, independent barrier: at ratio 1.0 its conviction clamp01(ratio / 3) = 0.333 is
+     under conviction_discard, whose stageable floor is 0.45. Loosening the gate alone is an
+     equivalent mutant; only removing both lets it fire, which this test catches.)
+  2. `metrics._avg_duration` reported an EMPTY population's mean as 0.0 — the same number a
+     population of genuinely zero-duration trades would give. A finder read the empty scalp
+     carve-out as ~1,598 zero-duration trades. The mean of nothing is now NaN (null in JSON).
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import math
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+from pathlib import Path
+
+import pytest
+
+from config.schemas import load_config
+from core.regime.regime_types import LiqState, RegimeType
+from core.signals.agon import AGON
+from core.signals.canonical import register_canonical
+from core.signals.provenance import ProvenanceStore
+from core.signals.signal_types import StrategyType
+from tests.backtest.data_loader import BacktestDataLoader
+from tests.backtest.metrics import ClosedTrade, compute_metrics
+from tests.backtest.synthetic_market import MarketSpec, SyntheticMarket
+from tests.backtest.tick_stream import build_factory, market_states
+from tests.optimizer_fixtures import CapturingLogger
+from tests.signals_fixtures import make_paramset, mk_regime
+
+ROOT = Path(__file__).resolve().parents[2]
+UTC = timezone.utc
+START = datetime(2014, 1, 6, tzinfo=UTC)
+
+
+def test_momentum_scalp_can_never_fire_on_a_uniform_synthetic_tape(tmp_path) -> None:
+    cfg = load_config(ROOT / "config")
+    m = SyntheticMarket(MarketSpec("planted", START, 7, (("EUR_USD", 1.10),)))
+    factory = build_factory(cfg, ["EUR_USD"])
+    store = ProvenanceStore(tmp_path / "provenance.db", cfg.system.provenance.revalidation_cadence_days,
+                            CapturingLogger())
+    register_canonical(store, START)
+
+    def agon() -> AGON:          # wired exactly as build_paper_loop wires it
+        return AGON(cfg.system.signals, cfg.instruments.pair_relationships, store,
+                    lambda inst, sess, kind: factory.session_median(inst, sess, kind) or 0.0,
+                    CapturingLogger())
+
+    real, surged = agon(), agon()
+    regime = mk_regime(RegimeType.STRONG_TREND_UP, liq=LiqState.DEEP)   # the scalp's gate is open
+    params = make_paramset()
+    fired = {"real": 0, "surged": 0}
+    ratios = set()
+    states = market_states(cfg=cfg, loader=BacktestDataLoader({m.name: m}, CapturingLogger()),
+                           factory=factory, source=m.name, instruments=["EUR_USD"],
+                           start=START, end=START + timedelta(hours=4))
+    for st in states:
+        median = factory.session_median("EUR_USD", st.session, "velocity")
+        if median is not None:
+            ratios.add(st.tick_velocity / median)
+        fast = dataclasses.replace(st, tick_velocity=st.tick_velocity * 2)  # the SAME bars, surging
+        for name, a, s in (("real", real, st), ("surged", surged, fast)):
+            a.observe(s)
+            sigs = a.generate(s, regime, params, s.timestamp)
+            fired[name] += sum(sig.strategy_type is StrategyType.MOMENTUM_SCALP for sig in sigs)
+    assert ratios == {1.0}                                     # pinned, every tick
+    assert cfg.system.signals.momentum_scalp_surge_ratio > 1.0
+    assert fired["real"] == 0
+    assert fired["surged"] > 0                                 # the module is alive, the tape is not
+
+
+def _trade(minutes: float, strategy: str) -> ClosedTrade:
+    t0 = datetime(2026, 1, 6, 10, tzinfo=UTC)
+    return ClosedTrade(entry_ts=t0, exit_ts=t0 + timedelta(minutes=minutes), pnl=Decimal("1"),
+                       strategy_type=strategy)
+
+
+def _metrics(trades):
+    eq = [(datetime(2026, 1, 5, tzinfo=UTC), Decimal("10000"))]
+    return compute_metrics(trades=trades, equity_curve=eq, rollover_marks=[], spx_closes={},
+                           periods_per_year=252)
+
+
+def test_an_empty_carve_out_has_no_mean_duration_never_zero() -> None:
+    m = _metrics([_trade(60, "TREND")])
+    assert math.isnan(m.scalp_avg_duration_s) and math.isnan(m.tsmom_avg_duration_s)
+    assert m.as_dict()["scalp_avg_duration_s"] is None          # null in every report json
+    zero = _metrics([_trade(60, "TREND"), _trade(0, "MOMENTUM_SCALP")])
+    assert zero.scalp_avg_duration_s == 0.0                      # a REAL zero is still visible
+    empty_band = _metrics([_trade(30, "TSMOM")])
+    assert math.isnan(empty_band.avg_trade_duration_s)
