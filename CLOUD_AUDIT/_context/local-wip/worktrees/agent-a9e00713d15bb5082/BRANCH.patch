@@ -0,0 +1,51 @@
+"""The venue-boundary checks each dispatch attempt runs, as REJECTED reports (ACIS-06 §4,
+master §7.5). Moved out of orchestrator.py (legibility budget, GAP-P12M-01). Invariants:
+  * Quantity (GAP-P12D-57): `units` go out rounded DOWN to the venue's lot step, never
+    up; below the venue's minimum lot nothing goes out. What is not sent is reported.
+  * Reduce-only (the close convention): a close names its position's side and may trade
+    at most what THIS venue holds on that side — capped at it, refused without it. It is
+    the engine's second line; the venue's own atomic close is the first (`close_position`).
+"""
+
+from __future__ import annotations
+
+from decimal import Decimal
+
+from core.execution.reports import ReportBook
+from core.execution.venue import ExecutionFace, FillReport
+from core.execution.venue_limits import reducible, venue_quantity
+from core.governor.portfolio_types import SizedOrder
+
+
+def side(order: SizedOrder) -> int:
+    """The side traded: a close names its position's side and trades the opposite."""
+    return -order.direction if order.action == "close" else order.direction
+
+
+def _refuse(reports: ReportBook, order: SizedOrder, units: Decimal,
+            fragment_id: str) -> list[FillReport]:
+    report = reports.reject(order, side(order), units=units, fragment_id=fragment_id)
+    reports.record(report)
+    return [report]
+
+
+def quantity_at(face: ExecutionFace, venue: str, order: SizedOrder, units: Decimal,
+                tag: str, reports: ReportBook, log) -> tuple[Decimal, list[FillReport]]:
+    sendable, rest = venue_quantity(units, face.descriptor)
+    if rest == 0:
+        return sendable, []
+    kind = "EXEC_MIN_LOT_REFUSED" if sendable == 0 else "EXEC_LOT_STEP_ROUNDED"
+    log.event(kind, order_id=order.order_id, venue=venue, action=order.action,
+              units=str(units), sent=str(sendable), unsent=str(rest))
+    return sendable, _refuse(reports, order, rest,
+                             f"{tag}:{'minlot' if sendable == 0 else 'step'}")
+
+
+async def reduce_only_at(face: ExecutionFace, venue: str, order: SizedOrder, units: Decimal,
+                         tag: str, reports: ReportBook, log) -> tuple[Decimal, list[FillReport]]:
+    held = reducible(await face.open_positions(), order)
+    if held >= units:
+        return units, []
+    kind = "EXEC_CLOSE_REFUSED" if held == 0 else "EXEC_CLOSE_CAPPED"
+    log.event(kind, order_id=order.order_id, venue=venue, units=str(units), held=str(held))
+    return held, _refuse(reports, order, units - held, f"{tag}:reduce")
diff --git a/core/execution/fill_store.py b/core/execution/fill_store.py
new file mode 100644
index 0000000..2015f81
--- /dev/null
+++ b/core/execution/fill_store.py
@@ -0,0 +1,63 @@
+"""The persisted fill log (ACIS-06 §10). Moved out of core/execution/venue.py, which
+re-exports it (legibility budget, GAP-P12M-01).
+
+Invariants:
+  * `fill_id` is the primary key, so ingestion is idempotent — a reconnect or restart
+    can never double-count a fill.
+  * Every venue hit leaves a row under that venue's name; boundary refusals that never
+    reached a venue are written under venue "none". So the rows under a venue's name
+    are a restart-proof lower bound on the requests sent to it (`request_times`,
+    GAP-P12D-57) — a restart cannot hand the engine a fresh request budget.
+"""
+
+from __future__ import annotations
+
+from datetime import datetime
+from pathlib import Path
+from typing import TYPE_CHECKING
+
+from core.data.sqlite_wal import open_store
+
+if TYPE_CHECKING:
+    from core.execution.venue import FillReport
+
+
+class FillReportStore:
+    _DDL = """
+    CREATE TABLE IF NOT EXISTS fill_report (
+        fill_id TEXT PRIMARY KEY, order_id TEXT NOT NULL,
+        fragment_id TEXT NOT NULL, ts TEXT NOT NULL,
+        instrument TEXT NOT NULL, direction INTEGER NOT NULL,
+        requested_px REAL NOT NULL, fill_px REAL NOT NULL,
+        filled_units TEXT NOT NULL, slippage_bps REAL NOT NULL,
+        venue TEXT NOT NULL, status TEXT NOT NULL,
+        remaining_units TEXT NOT NULL, session_id TEXT NOT NULL
+    );
+    CREATE INDEX IF NOT EXISTS ix_fill_order ON fill_report (order_id);"""
+
+    def __init__(self, db_path: str | Path) -> None:
+        self._conn = open_store(db_path)     # WAL + synchronous=FULL: power-loss durable (X4)
+        self._conn.executescript(self._DDL)
+        self._conn.commit()
+
+    def write(self, r: "FillReport") -> None:
+        self._conn.execute(
+            "INSERT OR IGNORE INTO fill_report VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
+            (r.fill_id, r.order_id, r.fragment_id, r.fill_time.isoformat(),
+             r.instrument, r.direction, r.requested_price, r.fill_price,
+             str(r.filled_units), r.slippage_bps, r.venue, r.status.value,
+             str(r.remaining_units), r.session_id))
+        self._conn.commit()
+
+    def request_times(self, venue: str, since: datetime) -> list[datetime]:
+        """When each logged request to `venue` at or after `since` was made."""
+        rows = self._conn.execute("SELECT ts FROM fill_report WHERE venue = ?",
+                                  (venue,)).fetchall()
+        stamps = (datetime.fromisoformat(ts) for (ts,) in rows)
+        return sorted(t for t in stamps if t >= since)
+
+    def row_count(self) -> int:
+        return self._conn.execute("SELECT COUNT(*) FROM fill_report").fetchone()[0]
+
+    def close(self) -> None:
+        self._conn.close()
